{
  "compilerOptions": {
    "target": "es2024",
    "module": "esnext",
    "moduleResolution": "bundler",
    "lib": ["es2024"],
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "exactOptionalPropertyTypes": true,
    "noImplicitOverride": true,
    "noFallthroughCasesInSwitch": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "skipLibCheck": true,
    "esModuleInterop": true,
    "allowImportingTsExtensions": true,
    "rewriteRelativeImportExtensions": true,
    "verbatimModuleSyntax": false,
    "types": ["node"],
    "noEmit": true,
    "paths": {
      "@andy1797833970/dsh-code-runtime-python": ["./packages/code-runtime/code-runtime-python/src/index.ts"],
      "@andy1797833970/dsh-code-runtime-python/invariant": ["./packages/code-runtime/code-runtime-python/src/invariant.ts"],
      "@andy1797833970/dsh-data-analysis": ["./packages/data-analysis/data-analysis/src/index.ts"],
      "@andy1797833970/dsh-data-analysis/types": ["./packages/data-analysis/data-analysis/src/types.ts"],
      "@andy1797833970/dsh-skill-data-analysis": ["./packages/data-analysis/skill-data-analysis/src/index.ts"],
      "@andy1797833970/dsh-bundle-data-analysis": ["./packages/data-analysis/bundle-data-analysis/src/index.ts"]
    }
  },
  "include": [
    "packages/**/src/**/*.ts",
    "packages/**/tests/**/*.ts"
  ],
  "exclude": [
    "packages/client"
  ]
}
